import json
from pathlib import Path

poems = [
    {
        "id": "molitva-do-arkhanhela-mykhaila",
        "title": "Молитва до Архангела Михаїла",
        "category": "духовна поезія",
        "tags": ["молитва", "Україна", "війна", "Батьківщина"],
        "text": """Архистратигу Михаїле, 
Поборнику ворожих сил! 
Державу нашу, Україну,
Від лиходіїв борони! 

Молюсь, Архангеле Господній, 
До тебе за свою країну, 
Дай силу нашому народу,
Щоб захистити Батьківщину!"""
    },
    {
        "id": "nichka",
        "title": "Нічка",
        "category": "дитяча поезія",
        "tags": ["діти", "ніч", "молитва", "війна", "мир"],
        "text": """У ліжках невеличкі 
Заснули малюки: 
Настала темна нічка,
І сяють зірочки.

А мами просять Бога:
Спокійна щоб була,
Щоб не було тривоги
Й закінчилась війна."""
    },
    {
        "id": "povertaysia-tatusiu",
        "title": "Повертайся, татусю…",
        "category": "дитяча поезія",
        "tags": ["родина", "тато", "діти", "молитва", "війна"],
        "text": """Повертайся, татусю, скоріше, 
Вся родина на тебе чекає.
Ми з тобою ще вивчимо вірші,
Переможе народ наш, я знаю! 

Я люблю тебе дуже, мій татку,
І молюся за тебе до Бога.
Та Небесного Тата прохаю: 
«Отче Наш, нам пошли перемогу!»"""
    },
    {
        "id": "molitva-do-bogorodytsi",
        "title": "Молитва до Богородиці",
        "category": "духовна поезія",
        "tags": ["молитва", "Богородиця", "Україна", "мир", "війна"],
        "text": """Свята Богородице, 
Матінко Божа,
Своїм омофором 
Наш край захисти! 
 
Небесна Царице,
Нехай переможуть
Свобода і правда,
Нехай буде мир!

І зло та неправда
Хай згинуть навіки,
Прошу Тебе, Мамо, 
Благаю, молю! 

За край мій рідненький
До Тебе молюся,
Бо нашу країну 
Я дуже люблю!"""
    },
    {
        "id": "soniashnyk",
        "title": "Соняшник",
        "category": "дитяча поезія",
        "tags": ["природа", "Україна", "діти", "Батьківщина"],
        "text": """На полі соняшник росте 
І сонце зустрічає.
А хмара темная мине — 
Це точно квітка знає! 

Зелене поле, рідний край,
Ведуть сюди стежини.
А ти, дитинко, підростай,
Люби свою країну!"""
    }
]

path = Path("/mnt/data/poems.json")
path.write_text(json.dumps(poems, ensure_ascii=False, indent=2), encoding="utf-8")

print(f"Создан файл: {path}")
print(f"Количество произведений: {len(poems)}")